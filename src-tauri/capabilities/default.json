  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main omp-desktop window.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"] },
