{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "momp",
  "version": "1.1.5",
  "identifier": "com.domovoyproj.momp",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:30141",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "momp",
        "width": 1280,
        "height": 800,
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": false,
    "copyright": "© 2026 domovoyproj",
    "publisher": "domovoyproj",
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
